@baseUrl = http://localhost:3000
@email = test@example.com

GET {{baseUrl}}/screenings
Accept: application/json

# @name book
POST {{baseUrl}}/screenings/s2/bookings
Content-Type: application/json

{
  "email": "{{email}}",
  "seats": 4,
  "tariff": "STUDENT"
}

GET {{baseUrl}}/bookings?email={{email}}
Accept: application/json

DELETE {{baseUrl}}/bookings/{{book.response.body.id}}

POST {{baseUrl}}/screenings/zz/bookings
Content-Type: application/json

{ "email": "{{email}}", "seats": 1 }

POST {{baseUrl}}/screenings/s1/bookings
Content-Type: application/json

{ "email": "{{email}}", "seats": 7 }

DELETE {{baseUrl}}/bookings/b1
